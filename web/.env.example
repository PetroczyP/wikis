# NextAuth.js
AUTH_SECRET=change-me-in-development  # Generate for production with: openssl rand -base64 32

# GitHub OAuth App — leave blank to hide the "Sign in with GitHub" button
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth App — leave blank to hide the "Sign in with Google" button
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to false to disable self-service account creation (UI toggle and API both blocked)
ALLOW_REGISTRATION=true

# Atlassian OAuth 2.0 + PKCE — client-side only, no secret required.
# Register an OAuth 2.0 (3LO) app at https://developer.atlassian.com/console/myapps/
# with redirect URI: http://localhost:3000/oauth/atlassian/callback (dev)
# Scopes: read:confluence-content.all read:confluence-space.summary
#         read:jira-work read:jira-user offline_access
NEXT_PUBLIC_ATLASSIAN_CLIENT_ID=

# RS256 JWT keys (for cross-service auth with FastAPI backend)
# Generate with:
#   openssl genrsa -out auth/keys/private.pem 2048
#   openssl rsa -in auth/keys/private.pem -pubout -out auth/keys/public.pem
JWT_PRIVATE_KEY=  # Contents of private.pem (paste full PEM including headers)
JWT_PUBLIC_KEY=   # Contents of public.pem (shared with backend for verification)
